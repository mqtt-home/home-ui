{
  "name": "@mqtt-home/ui",
  "version": "0.1.1",
  "description": "Home OS look for the mqtt-home UIs: tokens, components, Wall Display embed mode, prepaint script, DE/EN helper",
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["css", "*.js", "*.d.ts", "README.md"],
  "exports": {
    "./tailwind.css": "./css/tailwind.css",
    "./css": "./css/index.css",
    "./tokens.css": "./css/tokens.css",
    "./embed.css": "./css/embed.css",
    "./fonts.css": "./css/fonts.css",
    "./i18n": { "types": "./i18n.d.ts", "default": "./i18n.js" },
    "./vite": { "types": "./vite.d.ts", "default": "./vite.js" },
    "./prepaint": { "types": "./prepaint.d.ts", "default": "./prepaint.js" },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "vite": { "optional": true }
  }
}
